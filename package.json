{
  "name": "dsh-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin: local model gateway, provider cards, phone sign-in, daily check-in, usage board, and routing board.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.pt.md",
    "README.ru.md",
    "docs",
    "icon.svg",
    "LICENSE",
    "LICENSE-MAGPIE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
