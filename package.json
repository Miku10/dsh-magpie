{
  "name": "@local/dsh-magpie",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Developed from yetone/magpie (MIT, Copyright (c) 2026 yetone). A DeepSeek Harness plugin: one local gateway for every provider, account, routing group, and agent, with masking, usage, search, media, library, and sync.",
  "homepage": "https://github.com/yetone/magpie",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.pt.md",
    "README.ru.md",
    "docs",
    "icon.svg",
    "LICENSE",
    "LICENSE-MAGPIE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
